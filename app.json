{
  "name": "RMTA",
  "displayName": "RMTA",
  "expo": {
    "name": "RMTA",
    "slug": "rmta",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./src/Assets/images/appLogo.png",
    "splash": {
      "image": "./src/Assets/images/appLogo.png",
      "imageWidth": 280,
      "resizeMode": "contain",
      "backgroundColor": "#071A3D"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
